{
  "name": "@cloudrise/openclaw-channel-rocketchat",
  "version": "0.8.1",
  "description": "Rocket.Chat channel plugin for OpenClaw (fork WwagnerPO, compatible OpenClaw >= 2026.11)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "channel": {
      "id": "rocketchat",
      "label": "Rocket.Chat",
      "selectionLabel": "Rocket.Chat (self-hosted)",
      "docsPath": "/channels/rocketchat",
      "docsLabel": "rocketchat",
      "blurb": "Self-hosted team chat via Rocket.Chat REST + Realtime API.",
      "order": 66,
      "aliases": [
        "rc",
        "rocket"
      ]
    }
  },
  "dependencies": {
    "ws": "^8.14.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "openclaw": "^2026.11.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WwagnerPO/openclaw-channel-rocketchat.git"
  }
}
