# Rocket.Chat test credentials (DO NOT COMMIT REAL VALUES)
ROCKETCHAT_BASE_URL=http://localhost:3000
ROCKETCHAT_AUTH_TOKEN=replace_me
ROCKETCHAT_USER_ID=replace_me

# The plugin itself (inside the OpenClaw gateway) reads, for the default account:
#   ROCKETCHAT_AUTH_TOKEN or OPENCLAW_ROCKETCHAT_AUTH_TOKEN
#   ROCKETCHAT_USER_ID    or OPENCLAW_ROCKETCHAT_USER_ID
#   ROCKETCHAT_URL        or OPENCLAW_ROCKETCHAT_URL
# Values in openclaw.json (channels.rocketchat.*) take precedence over these.
